# Shell scripts must stay LF: they get executed by bash on macOS / Linux
# (GPU server, Apple-silicon launcher) where CRLF breaks the interpreter.
*.sh text eol=lf
install.sh text eol=lf

# PowerShell is CRLF-native.
*.ps1 text eol=crlf

# This reviewed evidence source is raw-byte pinned and must materialize identically
# on Windows and POSIX checkouts before the same-buffer launcher hashes it.
packages/vz-runtime/src/volvence_zero/offline_evidence/provision_volvence_evidence_event_log.ps1 text eol=lf

# Research papers and other PDF evidence must remain byte-exact and diff as binary.
*.pdf binary

# Relationship Lab evidence is content-addressed and validated from raw bytes.
# Keep its textual ledgers byte-identical across macOS/Linux and Windows checkouts.
artifacts/relationship_lab/**/*.json text eol=lf
artifacts/relationship_lab/**/*.jsonl text eol=lf
artifacts/relationship_lab/**/*.md text eol=lf
artifacts/relationship_lab/**/*.yaml text eol=lf
artifacts/relationship_lab/**/*.csv text eol=lf

# Frozen Product Horizon execution-source bundles preserve the exact observed
# checkout bytes, including reviewed CRLF. Never normalize these embedded files.
artifacts/relationship_lab/relationship_product_horizon_*/inputs/execution_sources/** -text

# Offline evidence protocols are content-addressed from their raw UTF-8 bytes.
# Keep protocol IDs reproducible across Windows and macOS/Linux checkouts.
packages/*/src/volvence_zero/offline_evidence/protocols/*.json text eol=lf
packages/lifeform-evolution/src/lifeform_evolution/protocols/*.json text eol=lf

