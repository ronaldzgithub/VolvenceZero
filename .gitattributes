# Shell scripts must stay LF: they get executed by bash on macOS / Linux
# (GPU server, Apple-silicon launcher) where CRLF breaks the interpreter.
*.sh text eol=lf
install.sh text eol=lf

# PowerShell is CRLF-native.
*.ps1 text eol=crlf

# Research papers and other PDF evidence must remain byte-exact and diff as binary.
*.pdf binary

# Keep the Volvence Codex raw chat snapshots pushable without bloating Git objects.
chats/volvence_codex_export_20260806/raw/active/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
chats/volvence_codex_export_20260806/raw/archived/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text

# Exported chat Markdown preserves source whitespace, including intentional hard breaks.
chats/volvence_codex_export_20260806/transcripts/*.md -whitespace
