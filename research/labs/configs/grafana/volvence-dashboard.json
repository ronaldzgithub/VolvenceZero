{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Runs Total by Probe",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (probe_id) (volvence_runs_total)",
          "legendFormat": "{{probe_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      }
    },
    {
      "title": "Gate Decisions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "volvence_gate_decision",
          "legendFormat": "{{probe_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "APPROVE", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "HOLD", "color": "yellow" } } },
            { "type": "value", "options": { "-1": { "text": "REJECT", "color": "red" } } }
          ]
        }
      }
    },
    {
      "title": "Metric Values (Latest)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "volvence_metric_value",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "probe_id": "Probe", "cell": "Cell", "metric_name": "Metric", "Value": "Value" }
          }
        }
      ]
    },
    {
      "title": "Run Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, probe_id) (rate(volvence_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{probe_id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, probe_id) (rate(volvence_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{probe_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Probes Registered",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "volvence_probes_registered",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Accuracy by Probe × Cell",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "volvence_metric_value{metric_name=\"accuracy\"}",
          "legendFormat": "{{probe_id}} / {{cell}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["volvence", "probes"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Volvence Labs — Probe Observatory",
  "uid": "volvence-main",
  "version": 1
}
