{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.optimizer-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "candidates",
    "component_frontiers",
    "selected_proposal_ids",
    "stop_reasons",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "forge-optimizer-decision.v1"},
    "decision": {"enum": ["SELECT", "STOP"]},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "component_frontiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "eligible_proposal_ids", "pareto_front_ids", "selected_ids"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "eligible_proposal_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"}
          },
          "pareto_front_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"}
          },
          "selected_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"}
          }
        }
      }
    },
    "selected_proposal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"}
    },
    "stop_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "component",
        "target",
        "eligible",
        "blocking_reasons",
        "metrics",
        "inputs"
      ],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"},
        "component": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "eligible": {"type": "boolean"},
        "blocking_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validation_delta", "capacity_cost", "added_lines", "risk_count"],
          "properties": {
            "validation_delta": {"type": "number", "minimum": -1, "maximum": 1},
            "capacity_cost": {"type": "number", "minimum": 0},
            "added_lines": {"type": "integer", "minimum": 1},
            "risk_count": {"type": "integer", "minimum": 1}
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch_sha256", "manifesto_sha256", "validation_sha256", "gate_sha256"],
          "properties": {
            "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "manifesto_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "gate_sha256": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              ]
            }
          }
        }
      }
    }
  }
}
