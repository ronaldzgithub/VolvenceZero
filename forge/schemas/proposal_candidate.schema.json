{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.proposal-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target", "operation", "section_content", "root_cause", "targeted_fix",
    "prediction", "at_risk_regressions", "preserve_behaviors"
  ],
  "properties": {
    "target": {"type": "string", "minLength": 1},
    "operation": {
      "enum": ["append_section", "append_yaml_sequence_item", "append_json_array_item"]
    },
    "document_path": {"type": "string", "minLength": 1, "maxLength": 120},
    "section_content": {"type": "string", "minLength": 20, "maxLength": 20000},
    "root_cause": {"type": "string", "minLength": 1, "maxLength": 2000},
    "targeted_fix": {"type": "string", "minLength": 1, "maxLength": 2000},
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "expected_delta", "evaluation_window"],
      "properties": {
        "metric": {"const": "pattern_occurrence_count"},
        "direction": {"const": "decrease"},
        "expected_delta": {"type": "integer", "maximum": -1},
        "evaluation_window": {"const": "next_mine_run"}
      }
    },
    "at_risk_regressions": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "preserve_behaviors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
