{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.validation-report.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "proposal_id", "status", "patch_sha256",
    "manifesto_sha256", "checks", "validated_at"
  ],
  "properties": {
    "schema_version": {"enum": ["forge-validation-report.v1", "forge-validation-report.v2"]},
    "proposal_id": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"},
    "status": {"enum": ["PASS", "BLOCK"]},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifesto_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {"type": "string", "minLength": 1},
    "runtime_gate_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "component", "target", "frozen_suite", "frozen_suite_sha256",
        "evaluated_test_ids", "baseline_passed_test_ids",
        "candidate_passed_test_ids", "baseline_pass_rate",
        "candidate_pass_rate", "validation_delta", "capacity_cost",
        "contract_integrity", "rollback_resilience", "judge"
      ],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "frozen_suite": {"type": "string", "minLength": 1},
        "frozen_suite_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluated_test_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline_passed_test_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_passed_test_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "validation_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "capacity_cost": {"const": 0.1},
        "contract_integrity": {"type": "boolean"},
        "rollback_resilience": {"type": "boolean"},
        "judge": {
          "type": "object", "additionalProperties": false,
          "required": ["backend", "model"],
          "properties": {
            "backend": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "BLOCK"]},
          "detail": {"type": "string"}
        }
      }
    },
    "validated_at": {"type": "string", "format": "date-time"}
  }
}
