{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.research-discovery.v1",
  "oneOf": [
    {"$ref": "#/$defs/demand"},
    {"$ref": "#/$defs/discovery_run"},
    {"$ref": "#/$defs/topic_proposal"},
    {"$ref": "#/$defs/demand_binding"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_string": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identified_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/content_ref"}
      }
    },
    "capability_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["appendable", "readable", "learnable", "steerable"]
      }
    },
    "corpus_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "bytes"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "claim"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_only",
        "human_topic_binding_required",
        "human_a0_required",
        "research_start_authorized",
        "formal_validation_performed",
        "production_promotion_authorized",
        "runtime_wiring_changed",
        "evaluation_is_learning_source"
      ],
      "properties": {
        "discovery_only": {"const": true},
        "human_topic_binding_required": {"const": true},
        "human_a0_required": {"const": true},
        "research_start_authorized": {"const": false},
        "formal_validation_performed": {"const": false},
        "production_promotion_authorized": {"const": false},
        "runtime_wiring_changed": {"const": false},
        "evaluation_is_learning_source": {"const": false}
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "demand_id",
        "claim_id",
        "title",
        "objective",
        "owner",
        "capability_axes",
        "need",
        "evidence",
        "discovery",
        "routing",
        "status",
        "authority",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": "forge-volvence-research-demand.v1"},
        "demand_id": {
          "type": "string",
          "pattern": "^research-demand:[0-9a-f]{64}$"
        },
        "claim_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "objective": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "capability_axes": {"$ref": "#/$defs/capability_axes"},
        "need": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_gap",
            "required_outcome",
            "success_criteria",
            "falsification_criteria",
            "protected_boundaries"
          ],
          "properties": {
            "current_gap": {"type": "string", "minLength": 1},
            "required_outcome": {"type": "string", "minLength": 1},
            "success_criteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "falsification_criteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "protected_boundaries": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/content_ref"}
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_roots",
            "max_source_files",
            "max_source_bytes",
            "max_topics"
          ],
          "properties": {
            "source_roots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "max_source_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "max_source_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 52428800
            },
            "max_topics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_mapping_id"],
          "properties": {
            "requested_mapping_id": {"$ref": "#/$defs/nullable_string"}
          }
        },
        "status": {"enum": ["OPEN", "PAUSED", "RETIRED"]},
        "authority": {"$ref": "#/$defs/authority"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "discovery_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "run_key",
        "demand",
        "corpus",
        "execution",
        "proposals",
        "authority",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": "forge-research-discovery-run.v1"},
        "run_id": {
          "type": "string",
          "pattern": "^research-discovery-run:[0-9a-f]{64}$"
        },
        "run_key": {"$ref": "#/$defs/sha256"},
        "demand": {"$ref": "#/$defs/identified_ref"},
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_sha256", "file_count", "total_bytes", "files"],
          "properties": {
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "file_count": {"type": "integer", "minimum": 1},
            "total_bytes": {"type": "integer", "minimum": 0},
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/corpus_file"}
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "model",
            "prompt_revision",
            "sandbox",
            "approval_mode",
            "turn_limit"
          ],
          "properties": {
            "backend": {"enum": ["codex_sdk", "replay"]},
            "model": {"type": "string", "minLength": 1},
            "prompt_revision": {"const": "demand-topic-discovery.v1"},
            "sandbox": {"const": "read_only"},
            "approval_mode": {"const": "deny_all"},
            "turn_limit": {"const": 1}
          }
        },
        "proposals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identified_ref"}
        },
        "authority": {"$ref": "#/$defs/authority"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "topic_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "demand",
        "discovery_run_id",
        "corpus_sha256",
        "capability_axes",
        "topic",
        "source_refs",
        "binding_status",
        "authority",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": "forge-research-topic-proposal.v1"},
        "proposal_id": {
          "type": "string",
          "pattern": "^research-topic-proposal:[0-9a-f]{64}$"
        },
        "demand": {"$ref": "#/$defs/identified_ref"},
        "discovery_run_id": {
          "type": "string",
          "pattern": "^research-discovery-run:[0-9a-f]{64}$"
        },
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "capability_axes": {"$ref": "#/$defs/capability_axes"},
        "topic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "hypothesis",
            "mechanism",
            "demand_relevance",
            "research_question",
            "suggested_method",
            "success_signals",
            "falsification_signals",
            "caveats"
          ],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 240},
            "hypothesis": {"type": "string", "minLength": 1},
            "mechanism": {"type": "string", "minLength": 1},
            "demand_relevance": {"type": "string", "minLength": 1},
            "research_question": {"type": "string", "minLength": 1},
            "suggested_method": {"type": "string", "minLength": 1},
            "success_signals": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "falsification_signals": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "caveats": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_ref"}
        },
        "binding_status": {"const": "UNBOUND"},
        "authority": {"$ref": "#/$defs/authority"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "demand_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_id",
        "demand",
        "proposal",
        "registry",
        "mapping",
        "decision",
        "review",
        "authority",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": "forge-research-demand-binding.v1"},
        "binding_id": {
          "type": "string",
          "pattern": "^research-demand-binding:[0-9a-f]{64}$"
        },
        "demand": {"$ref": "#/$defs/identified_ref"},
        "proposal": {"$ref": "#/$defs/identified_ref"},
        "registry": {"$ref": "#/$defs/content_ref"},
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapping_id",
            "binding_sha256",
            "task_id",
            "owner",
            "capability_axes"
          ],
          "properties": {
            "mapping_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
            "binding_sha256": {"$ref": "#/$defs/sha256"},
            "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
            "owner": {"type": "string", "minLength": 1},
            "capability_axes": {"$ref": "#/$defs/capability_axes"}
          }
        },
        "decision": {"enum": ["APPROVE", "REJECT"]},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed_by", "reason"],
          "properties": {
            "reviewed_by": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic_submission_to_a0_authorized",
            "human_a0_required",
            "research_start_authorized",
            "formal_validation_authorized",
            "production_promotion_authorized",
            "runtime_wiring_changed",
            "evaluation_is_learning_source"
          ],
          "properties": {
            "topic_submission_to_a0_authorized": {"type": "boolean"},
            "human_a0_required": {"const": true},
            "research_start_authorized": {"const": false},
            "formal_validation_authorized": {"const": false},
            "production_promotion_authorized": {"const": false},
            "runtime_wiring_changed": {"const": false},
            "evaluation_is_learning_source": {"const": false}
          }
        },
        "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"decision": {"const": "APPROVE"}},
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "topic_submission_to_a0_authorized": {"const": true}
                }
              }
            }
          },
          "else": {
            "properties": {
              "authority": {
                "properties": {
                  "topic_submission_to_a0_authorized": {"const": false}
                }
              }
            }
          }
        }
      ]
    }
  }
}
