{
  "type": "object",
  "required": ["facts"],
  "properties": {
    "facts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "confidence",
          "evidence",
          "semantic_key",
          "canonical_value"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["create", "revise", "activate", "block"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string", "maxLength": 160 },
          "semantic_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "canonical_value": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
