{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.volvence.ai/synthetic-experience/render-slots-v1.json",
  "title": "Synthetic experience text-slot render response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trajectory_id",
    "slots"
  ],
  "properties": {
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_id",
          "text"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
