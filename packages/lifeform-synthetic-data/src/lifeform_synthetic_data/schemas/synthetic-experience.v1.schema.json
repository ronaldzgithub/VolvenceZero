{
  "$defs": {
    "AnnotationRecord": {
      "additionalProperties": false,
      "properties": {
        "adjudication": {
          "enum": [
            "not_required",
            "pending",
            "accepted",
            "rejected",
            "conflicted"
          ],
          "type": "string"
        },
        "annotation_id": {
          "type": "string"
        },
        "annotator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label_key": {
          "type": "string"
        },
        "label_value_json": {
          "type": "string"
        },
        "ontology": {
          "type": "string"
        },
        "ontology_version": {
          "type": "string"
        },
        "scope_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "enum": [
            "generator_truth",
            "environment_fact",
            "runtime_snapshot",
            "human_annotation",
            "model_prediction",
            "evaluation_readout"
          ],
          "type": "string"
        },
        "target_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_ref": {
          "type": "string"
        },
        "timescale": {
          "enum": [
            "online-fast",
            "session-medium",
            "background-slow",
            "rare-heavy",
            "turn",
            "session",
            "cross_session"
          ],
          "type": "string"
        },
        "track": {
          "enum": [
            "world",
            "self",
            "dual",
            "shared",
            "group"
          ],
          "type": "string"
        },
        "training_use": {
          "enum": [
            "target",
            "feature_only",
            "eval_only",
            "quarantined"
          ],
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "target_ref",
        "ontology",
        "ontology_version",
        "label_key",
        "label_value_json",
        "source",
        "training_use",
        "confidence",
        "evidence_refs",
        "target_owner",
        "track",
        "timescale",
        "scope_ids",
        "adjudication",
        "annotator_id"
      ],
      "title": "AnnotationRecord",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "license_id": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "sha256",
        "mime_type",
        "license_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CorpusManifest": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "family_counts": {
          "items": {
            "$ref": "#/$defs/CountEntry"
          },
          "type": "array"
        },
        "generated_at": {
          "type": "string"
        },
        "generation_tier": {
          "enum": [
            "structural",
            "rendered",
            "live_through"
          ],
          "type": "string"
        },
        "generator_version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt_hashes": {
          "items": {
            "$ref": "#/$defs/KeyValue"
          },
          "type": "array"
        },
        "quality": {
          "items": {
            "$ref": "#/$defs/QualityRecord"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "scenario_package_hash": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "shard_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "split_counts": {
          "items": {
            "$ref": "#/$defs/CountEntry"
          },
          "type": "array"
        },
        "trajectory_count": {
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "corpus_id",
        "run_id",
        "generated_at",
        "generator_version",
        "git_sha",
        "scenario_package_hash",
        "generation_tier",
        "trajectory_count",
        "split_counts",
        "family_counts",
        "model_ids",
        "prompt_hashes",
        "shard_refs",
        "quality",
        "description"
      ],
      "title": "CorpusManifest",
      "type": "object"
    },
    "CountEntry": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "count"
      ],
      "title": "CountEntry",
      "type": "object"
    },
    "ExperienceSession": {
      "additionalProperties": false,
      "properties": {
        "gap_days_before": {
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "session_index": {
          "type": "integer"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/ExperienceTurn"
          },
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "session_index",
        "gap_days_before",
        "turns"
      ],
      "title": "ExperienceSession",
      "type": "object"
    },
    "ExperienceTrajectory": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/AnnotationRecord"
          },
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "family": {
          "type": "string"
        },
        "generation_tier": {
          "enum": [
            "structural",
            "rendered",
            "live_through"
          ],
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "metadata": {
          "items": {
            "$ref": "#/$defs/KeyValue"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceRecord"
        },
        "quality": {
          "items": {
            "$ref": "#/$defs/QualityRecord"
          },
          "type": "array"
        },
        "scenario_hash": {
          "type": "string"
        },
        "scenario_ref": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/ExperienceSession"
          },
          "type": "array"
        },
        "snapshot_frames": {
          "items": {
            "$ref": "#/$defs/SnapshotFrame"
          },
          "type": "array"
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "type": "string"
        },
        "trajectory_id": {
          "type": "string"
        },
        "truth_frames": {
          "items": {
            "$ref": "#/$defs/LatentTruthFrame"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "trajectory_id",
        "scenario_ref",
        "scenario_hash",
        "split",
        "family",
        "language",
        "generation_tier",
        "sessions",
        "truth_frames",
        "snapshot_frames",
        "annotations",
        "artifacts",
        "quality",
        "provenance",
        "metadata"
      ],
      "title": "ExperienceTrajectory",
      "type": "object"
    },
    "ExperienceTurn": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "latent_frame_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "items": {
            "$ref": "#/$defs/KeyValue"
          },
          "type": "array"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "type": "string"
        },
        "session_index": {
          "type": "integer"
        },
        "snapshot_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "turn_index": {
          "type": "integer"
        }
      },
      "required": [
        "turn_id",
        "session_index",
        "turn_index",
        "role",
        "text",
        "event_id",
        "latent_frame_ref",
        "snapshot_refs",
        "artifact_refs",
        "metadata"
      ],
      "title": "ExperienceTurn",
      "type": "object"
    },
    "KeyValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "KeyValue",
      "type": "object"
    },
    "LatentTruthFrame": {
      "additionalProperties": false,
      "properties": {
        "annotation_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "event_kind": {
          "type": "string"
        },
        "frame_id": {
          "type": "string"
        },
        "observable_facts": {
          "items": {
            "$ref": "#/$defs/KeyValue"
          },
          "type": "array"
        },
        "phase_id": {
          "type": "string"
        },
        "private_facts": {
          "items": {
            "$ref": "#/$defs/KeyValue"
          },
          "type": "array"
        },
        "response_contract": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turn_ref": {
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "turn_ref",
        "phase_id",
        "event_kind",
        "observable_facts",
        "private_facts",
        "response_contract",
        "annotation_refs"
      ],
      "title": "LatentTruthFrame",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "consent_basis": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "generator_version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "license_id": {
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string"
        },
        "scenario_hash": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "source_kind": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "source_kind",
        "generator_version",
        "seed",
        "scenario_hash",
        "git_sha",
        "model_id",
        "prompt_hash",
        "created_at",
        "license_id",
        "consent_basis"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "QualityRecord": {
      "additionalProperties": false,
      "properties": {
        "check_kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "quality_id": {
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "type": "string"
        }
      },
      "required": [
        "quality_id",
        "check_kind",
        "passed",
        "severity",
        "score",
        "evidence_refs",
        "description"
      ],
      "title": "QualityRecord",
      "type": "object"
    },
    "SnapshotFrame": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "payload_json": {
          "type": "string"
        },
        "slot_name": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "timestamp_ms": {
          "type": "integer"
        },
        "turn_ref": {
          "type": "string"
        },
        "value_hash": {
          "type": "string"
        },
        "value_type": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "wiring_level": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "turn_ref",
        "slot_name",
        "owner",
        "version",
        "timestamp_ms",
        "value_type",
        "value_hash",
        "payload_json",
        "wiring_level",
        "description"
      ],
      "title": "SnapshotFrame",
      "type": "object"
    }
  },
  "$id": "https://schemas.volvence.ai/synthetic-experience/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/ExperienceTrajectory"
    },
    {
      "$ref": "#/$defs/CorpusManifest"
    }
  ],
  "title": "Volvence Unified Synthetic Experience Corpus v1"
}
