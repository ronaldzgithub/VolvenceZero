{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.volvence.ai/synthetic-experience/cursor-authored-render-v1.json",
  "title": "Cursor-authored synthetic dialogue render assets v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "cursor-authored-render.v1"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "language",
        "sessions"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "zh",
            "en",
            "bilingual"
          ]
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_index",
        "turns"
      ],
      "properties": {
        "session_index": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_index",
        "role",
        "variants"
      ],
      "properties": {
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
