{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:volvence:schema:venture-foundry-public-contract:v1",
  "title": "Venture Brain Foundry public producer contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "consumer",
    "request_schema_version",
    "context_pack_schema_version",
    "advice_schema_version",
    "outcome_report_schema_version",
    "outcome_receipt_schema_version",
    "service_contract",
    "decision_points",
    "exposure_contract",
    "advice_contract",
    "content_policy_contract",
    "outcome_contract",
    "isolation_contract",
    "rollback_contract",
    "production_activation_contract",
    "contract_id",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "venture-foundry-public-contract.v1"},
    "producer": {"const": "lifeform-domain-venture"},
    "consumer": {"const": "foundry"},
    "request_schema_version": {"const": "venture-context-request.v1"},
    "context_pack_schema_version": {"const": "venture-context-pack.v1"},
    "advice_schema_version": {"const": "venture-advice.v1"},
    "outcome_report_schema_version": {"const": "venture-outcome-report.v1"},
    "outcome_receipt_schema_version": {"const": "venture-outcome-receipt.v1"},
    "service_contract": {
      "const": {
        "session_vertical": "venture",
        "primary_context_path": "/v1/sessions/{session_id}/brain/context-packs",
        "primary_outcome_path": "/v1/sessions/{session_id}/brain/outcomes",
        "legacy_aliases": [
          "/v1/sessions/{session_id}/venture/context-packs",
          "/v1/sessions/{session_id}/venture/outcomes"
        ],
        "legacy_aliases_authoritative": false
      }
    },
    "decision_points": {
      "const": [
        "opportunity_brainstorm",
        "candidate_comparison",
        "experiment_planning",
        "product_design",
        "portfolio_review",
        "monitor_attribution",
        "stop_review"
      ]
    },
    "exposure_contract": {
      "const": {
        "owner": "foundry",
        "pairing_arms": ["off", "shadow"],
        "pairing_required": true,
        "required_exposure_fields": [
          "cohort_id",
          "arm",
          "user_id",
          "portfolio_id",
          "decision_id",
          "decision_point"
        ],
        "producer_exchange_lineage_fields": [
          "context_pack_id",
          "content_sha256",
          "source_entry_ids",
          "content_policy_wiring_level",
          "content_policy_decision.policy_decision_id",
          "settled_policy_credits",
          "policy_updates",
          "advice.advice_id",
          "advice.applied"
        ],
        "producer_assigns_cohort": false,
        "producer_reports_effectiveness": false
      }
    },
    "advice_contract": {
      "const": {
        "wiring_level": "shadow",
        "applied": false,
        "active_allowed": false,
        "adoption_is_learning_signal": false
      }
    },
    "content_policy_contract": {
      "const": {
        "owner": "lifeform-domain-venture",
        "wiring_levels": ["active", "disabled"],
        "decision_field": "content_policy_decision",
        "owner_order_field": "source_entry_ids",
        "output_order_field": "content_policy_decision.output_entry_ids",
        "source_order_equals_output_order": true,
        "maximum_promoted_entries": 1,
        "strict_noop_preserves_order": true,
        "settled_credit_count": 4,
        "learning_signal": "prediction_error_credit_only",
        "evaluation_is_learning_signal": false,
        "checkpoint_scope": ["portfolio_id", "venture_id"],
        "checkpoint_carrier": "memory_owner"
      }
    },
    "outcome_contract": {
      "const": {
        "typed_decision_field": "decision",
        "delayed_business_outcome_field": "commercial_outcome",
        "pe_eligible_pair": {
          "evidence_class": "field",
          "outcome_kind": "field_experiment_result"
        },
        "settlement_point": "next_new_context_pack",
        "receipt_lineage_fields": [
          "source_advice_id",
          "source_advice_applied",
          "source_content_policy_decision_id",
          "content_policy_action_applied"
        ]
      }
    },
    "isolation_contract": {
      "const": {
        "user_scope_source": "lifeform_session_identity",
        "portfolio_scope_source": "request.portfolio_id",
        "venture_scope_source": "request.venture_id",
        "cross_user_recall_allowed": false,
        "cross_portfolio_recall_allowed": false,
        "cross_venture_recall_allowed": false
      }
    },
    "rollback_contract": {
      "const": {
        "owner": "foundry",
        "fallback_mode": "off",
        "stop_consuming_context_pack_is_rollback": true,
        "service_failure_auto_activation_allowed": false
      }
    },
    "production_activation_contract": {
      "const": {
        "effectiveness_result": "candidate_only",
        "approval_authority": "foundry_named_human",
        "producer_activation_api_exposed": false,
        "producer_self_approval_allowed": false,
        "advice_active_allowed": false
      }
    },
    "contract_id": {
      "const": "venture-foundry-public-contract:a1767651e680ce4e350cfcaa320c664c94ffdb38fadca3b5029461f2713f69e5"
    },
    "content_sha256": {
      "const": "a1767651e680ce4e350cfcaa320c664c94ffdb38fadca3b5029461f2713f69e5"
    }
  }
}
