{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volvence.local/schemas/relationship-p1m-surface-render.v1.json",
  "title": "Relationship P1m surface render",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "history_utterances",
    "current_input",
    "reactions_a",
    "reactions_b"
  ],
  "properties": {
    "history_utterances": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 14, "maxLength": 220}
    },
    "current_input": {"type": "string", "minLength": 14, "maxLength": 220},
    "reactions_a": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 8, "maxLength": 160}
    },
    "reactions_b": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 8, "maxLength": 160}
    }
  }
}
