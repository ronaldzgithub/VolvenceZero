{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "companion.playbook-overlay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "version",
    "owner",
    "playbook_rules",
    "description"
  ],
  "properties": {
    "schema_version": {"const": "companion-playbook-overlay.v1"},
    "overlay_id": {"const": "companion-forge-reviewed-v1"},
    "version": {"type": "string", "minLength": 1},
    "owner": {"const": "lifeform-domain-emogpt"},
    "playbook_rules": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/playbook_rule"}
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "$defs": {
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "playbook_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "problem_pattern",
        "recommended_regime",
        "recommended_ordering",
        "recommended_pacing",
        "avoid_patterns",
        "knowledge_weight_hint",
        "experience_weight_hint",
        "applicability_scope",
        "confidence",
        "description"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^rid-companion:forge:[a-z0-9][a-z0-9_-]*$"
        },
        "problem_pattern": {"type": "string", "minLength": 1, "maxLength": 160},
        "recommended_regime": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 120}
          ]
        },
        "recommended_ordering": {"$ref": "#/$defs/nonempty_string_array"},
        "recommended_pacing": {"type": "string", "minLength": 1, "maxLength": 120},
        "avoid_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "knowledge_weight_hint": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "experience_weight_hint": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "applicability_scope": {"$ref": "#/$defs/nonempty_string_array"},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
